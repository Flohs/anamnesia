/bin/
/dist/
/.env
/.dev/
*.test
*.out
.DS_Store

# The console's Node toolchain. The built bundle is NOT ignored: it lives in
# internal/ui/dist/ and is committed, because go:embed needs it at compile
# time and `go install` must keep working without Node.
/ui/node_modules/
*.tsbuildinfo

# IDEs
/.idea/
/.vscode/

# Benchmark inputs (downloadable, longmemeval_s.json is ~278MB)
/data/
/scripts/longmemeval/*.json

# Benchmark run artifacts
/out/

# Python
__pycache__/
*.pyc

# Local Claude Code settings. Kept out of the repository on purpose: these
# are per-machine (permission grants, enabled plugins, a local skill copy),
# not project configuration other people should inherit.
/.claude/

# Compiled example agent binary
/examples/cli-companion/cli-companion

# Superpowers working documents (specs, plans, agent scratch). Kept out of
# the repository: they are process artifacts of how a change was arrived at,
# not documentation of the app. The GitHub wiki is that.
/docs/superpowers/

# Agent instructions for this codebase. Local, not inherited by clones.
/CLAUDE.md


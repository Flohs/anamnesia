# Anamnesia local stack configuration.
# Copy to .env and edit; docker-compose picks it up automatically.

# Default identity for memory rows that don't supply explicit values.
# A small team can either share `default` or pass --user on the host.
ANAMNESIA_DEFAULT_USER=default

# Host-side ports (override if anything already binds these).
ANAMNESIA_HTTP_PORT=8181
ANAMNESIA_POSTGRES_PORT=5434

# Optional shared secret. If set, every /v1/* and /mcp request must
# include `Authorization: Bearer <token>`. Leave blank for an
# unauthenticated localhost stack.
ANAMNESIA_SERVER_TOKEN=

# Embedding provider. Use `stub` for offline / dev; `openai` for real
# embeddings (works against OpenAI, OpenRouter, vLLM, Ollama with the
# right base URL).
ANAMNESIA_EMBED_PROVIDER=stub
ANAMNESIA_EMBED_MODEL=text-embedding-3-small
ANAMNESIA_EMBED_DIMS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM provider (consolidation + extraction worker).
#   stub       — placeholder output, no API calls (default; works offline).
#   anthropic  — real distillation via Claude; needs ANTHROPIC_API_KEY.
#   openai     — any OpenAI-compatible /chat/completions endpoint
#                (OpenAI, OpenRouter, vLLM, Ollama, Azure OpenAI);
#                needs OPENAI_API_KEY and respects OPENAI_BASE_URL.
# Model defaults are picked per provider when ANAMNESIA_LLM_MODEL is unset:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o-mini
ANAMNESIA_LLM_PROVIDER=stub
ANAMNESIA_LLM_MODEL=
ANTHROPIC_API_KEY=

# Reranker (optional). When set, hybrid search candidates are scored a
# second time by Cohere's rerank endpoint. Trades latency for quality.
ANAMNESIA_RERANK_PROVIDER=none
ANAMNESIA_RERANK_MODEL=rerank-english-v3.0
COHERE_API_KEY=

# PII detector. `regex` is a lightweight in-process sweep (default);
# `presidio` calls Microsoft Presidio at ANAMNESIA_PRESIDIO_URL.
# Mode `tag` records detected categories on the row; `redact` also
# replaces matches with `[TYPE]` placeholders before persisting.
ANAMNESIA_PII_PROVIDER=regex
ANAMNESIA_PII_MODE=tag
ANAMNESIA_PRESIDIO_URL=

# Worker cadences (Go duration strings).
ANAMNESIA_EMBED_BACKFILL=1m
ANAMNESIA_FORGET_EVERY=1h
ANAMNESIA_DECAY_EVERY=1h
ANAMNESIA_CONSOLIDATE_EVERY=24h
# Extract worker drains pending sources from /v1/ingest. With the stub
# LLM provider this is effectively idle. Bump up if you have a real
# LLM key and want extraction to feel snappy.
ANAMNESIA_EXTRACT_EVERY=15s
